# ====================================
# 敏感信息：绝对不能提交到git仓库
# 需求 ：API 密钥不得出现在公开仓库中
# ====================================
# 注意：! 反向排除必须紧跟在要排除的规则之后，否则会被后续规则重新覆盖
.env
.env.*
!.env.example
*.pem
*.key
secret.json

# ====================================
# 运行时数据：本地生成，不提交到git仓库
# ====================================
backend/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
uploads/
logs/
*.log

backend/*.txt
backend/try_*.py
backend/probe*.py
backend/verify_*.py
backend/dump_*.py
backend/dev.ps1
backend/out.*




# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ============================================================
#  前端
# ============================================================
node_modules/
.DS_Store
Thumbs.db

# ============================================================
#  编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
*~
desktop.ini

# ============================================================
#  大文件：测试 PDF 共 125 MB，不进仓库
#  只忽略根目录，否则 docs/ 下的技术文档 PDF 也会被误忽略
#  （git 规则：父目录被忽略时，无法用 ! 重新包含其中的文件）
# ============================================================
/*.pdf



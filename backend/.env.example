# 复制本文件为 .env 后再填入真实值
# 命令：Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，不会进入仓库
#
# ---- 大模型（OpenAI 兼容）----
# DeepSeek:    https://api.deepseek.com/v1
# OpenAI:      https://api.openai.com/v1
# 本地 Ollama: http://localhost:11434/v1
APP_LLM_BASE_URL=https://api.deepseek.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL_CHAT=deepseek-chat
APP_LLM_MODEL_REASONER=deepseek-reasoner

# ---- 嵌入模型（向量检索）----
# 留空则向量检索自动降级为纯 BM25，检索功能不中断
# 阿里云百炼 OpenAI 兼容端点：
#   https://dashscope.aliyuncs.com/compatible-mode/v1
APP_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_EMBEDDING_API_KEY=
APP_EMBEDDING_MODEL=text-embedding-v3

# ---- 应用 ----
APP_LOG_LEVEL=INFO
APP_DEBUG=true
